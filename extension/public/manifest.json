{
  "manifest_version": 3,
  "name": "Chat City for Twitch",
  "short_name": "Chat City",
  "version": "0.1.0",
  "description": "Watch any Twitch stream's chat build a pixel city over the player. Kind chat builds it, haters knock it down.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Chat City", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "permissions": ["storage"],
  "content_scripts": [
    { "matches": ["https://www.twitch.tv/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["overlay.html", "assets/*"], "matches": ["https://www.twitch.tv/*"] }
  ]
}
